# Copy to .env and fill in. .env is gitignored — never commit it.

# --- AWS ---------------------------------------------------------------
NG_DEPLOY_AWS_ACCESS_KEY_ID=
NG_DEPLOY_AWS_SECRET_ACCESS_KEY=
NG_DEPLOY_AWS_BUCKET=www.arte-calendar.com
NG_DEPLOY_AWS_REGION=eu-central-1

# --- Optional ----------------------------------------------------------
# Skip the alias lookup by pinning the distribution.
# CLOUDFRONT_DISTRIBUTION_ID=

# The PUBLIC hostname. Set this whenever it differs from the bucket name —
# here the bucket is named after an old brand, so without it the CloudFront
# alias lookup searches for the wrong domain and finds nothing.
SITE_DOMAIN=www.cloud-calendars.com

# Angular project name; must match angular.json.
# ANGULAR_PROJECT=arte-calendar

# Absolute paths, if the binaries are not on PATH.
# NPM_BIN=
# AWS_BIN=
