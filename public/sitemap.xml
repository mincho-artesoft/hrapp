<?xml version="1.0" encoding="UTF-8"?>
<!--
  Four URLs, which is all this site has. Everything on the home page is one
  document — the showcase, weather hub, pricing and FAQ are sections, not
  routes, so listing them as URLs would be lying to a crawler.

  Keep this in step with app.routes.ts and with the SPA fallback list in
  scripts/deploy.sh. A route in the router but missing here is invisible to
  search; a URL here that the deploy script does not upload is a soft 404.
-->
<urlset xmlns="http://www.sitemaps.org/schemas/sitemap/0.9"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.sitemaps.org/schemas/sitemap/0.9
                            http://www.sitemaps.org/schemas/sitemap/0.9/sitemap.xsd">

  <url>
    <loc>https://www.cloud-calendars.com/</loc>
    <lastmod>2026-07-29</lastmod>
    <changefreq>weekly</changefreq>
    <priority>1.0</priority>
  </url>

  <url>
    <loc>https://www.cloud-calendars.com/how-cloud-calendars-rescued-my-schedule-and-sanity.html</loc>
    <lastmod>2025-09-05</lastmod>
    <changefreq>yearly</changefreq>
    <priority>0.6</priority>
  </url>

  <url>
    <loc>https://www.cloud-calendars.com/privacy-policy</loc>
    <lastmod>2026-07-29</lastmod>
    <changefreq>yearly</changefreq>
    <priority>0.3</priority>
  </url>

  <url>
    <loc>https://www.cloud-calendars.com/terms-of-service</loc>
    <lastmod>2026-07-29</lastmod>
    <changefreq>yearly</changefreq>
    <priority>0.3</priority>
  </url>

</urlset>
