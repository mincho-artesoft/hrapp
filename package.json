{
  "name": "cloud-calendars-api-nest",
  "version": "1.0.0",
  "description": "NestJS serverless port of the Cloud Calendars API (S3-as-DB, API Gateway v2 → Lambda)",
  "private": true,
  "type": "commonjs",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test:sharing": "ts-node test/calendar-sharing.integration.ts",
    "start:dev": "PORT=3000 ts-node src/local.ts",
    "package": "bash deploy.sh package",
    "deploy": "bash deploy.sh"
  },
  "dependencies": {
    "@aws-sdk/client-sesv2": "3.1121.0",
    "@codegenie/serverless-express": "^4.16.0",
    "@nestjs/common": "^10.4.15",
    "@nestjs/core": "^10.4.15",
    "@nestjs/platform-express": "^10.4.15",
    "express": "^4.21.2",
    "pngjs": "^5.0.0",
    "qrcode": "^1.5.4",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1"
  },
  "devDependencies": {
    "@aws-sdk/client-s3": "^3.700.0",
    "@types/aws-lambda": "^8.10.145",
    "@types/express": "^4.17.21",
    "@types/node": "^20.17.0",
    "@types/qrcode": "^1.5.5",
    "ts-node": "^10.9.2",
    "typescript": "^5.6.3"
  }
}
