{
  "name": "arte-calendar",
  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "start": "node tools/build-article-index.mjs && ng serve",
    "build": "node tools/build-article-index.mjs && ng build && node tools/postbuild.mjs",
    "watch": "ng build --watch --configuration development",
    "test": "ng test",
    "deploy": "bash scripts/deploy.sh",
    "deploy:dry": "DRY_RUN=1 bash scripts/deploy.sh",
    "deploy:invalidate": "INVALIDATE_ONLY=1 bash scripts/deploy.sh",
    "test:cloudfront": "node --test scripts/tests/cloudfront-router.test.mjs",
    "check:associated-domain": "node scripts/check-associated-domain.mjs",
    "visibility:live": "node ai-visibility/live-check.mjs https://www.cloud-calendars.com",
    "visibility:indexnow": "node ai-visibility/indexnow.mjs https://www.cloud-calendars.com",
    "visibility:logs": "bash scripts/fetch-crawler-logs.sh && node ai-visibility/crawler-log.mjs .crawler-logs/cloudfront --days=30"
  },
  "private": true,
  "dependencies": {
    "@angular/animations": "19.2.25",
    "@angular/cdk": "^19.2.14",
    "@angular/common": "19.2.25",
    "@angular/compiler": "19.2.25",
    "@angular/core": "19.2.25",
    "@angular/forms": "19.2.25",
    "@angular/material": "^19.2.14",
    "@angular/platform-browser": "19.2.25",
    "@angular/platform-browser-dynamic": "19.2.25",
    "@angular/platform-server": "19.2.25",
    "@angular/router": "19.2.25",
    "@angular/ssr": "^19.2.27",
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource-variable/jetbrains-mono": "^5.3.0",
    "@fontsource-variable/sora": "^5.3.0",
    "qrcode-generator": "^1.5.2",
    "rxjs": "~7.8.0",
    "three": "^0.169.0",
    "tslib": "^2.3.0",
    "zone.js": "~0.15.0"
  },
  "devDependencies": {
    "@angular-devkit/build-angular": "^19.2.27",
    "@angular/build": "^19.2.27",
    "@angular/cli": "^19.2.27",
    "@angular/compiler-cli": "19.2.25",
    "@jefiozie/ngx-aws-deploy": "^4.1.0",
    "@types/jasmine": "~5.1.0",
    "@types/node": "^26.4.0",
    "@types/three": "^0.169.0",
    "jasmine-core": "~5.6.0",
    "karma": "~6.4.0",
    "karma-chrome-launcher": "~3.2.0",
    "karma-coverage": "~2.2.0",
    "karma-jasmine": "~5.1.0",
    "karma-jasmine-html-reporter": "~2.1.0",
    "playwright": "^1.49.1",
    "typescript": "~5.7.2"
  }
}
