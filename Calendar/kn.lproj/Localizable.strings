"AboutPressure_Body"   = "ಹವಾಮಾನದಲ್ಲಿನ ಬದಲಾವಣೆಗಳನ್ನು ಊಹಿಸಲು ಒತ್ತಡದಲ್ಲಿನ ಮಹತ್ವದ, ವೇಗದ ಬದಲಾವಣೆಗಳನ್ನು ಬಳಸಲಾಗುತ್ತದೆ. ಉದಾಹರಣೆಗೆ, ಒತ್ತಡದಲ್ಲಿನ ಇಳಿಕೆ ಮಳೆ ಅಥವಾ ಹಿಮವು ಬರುತ್ತಿದೆ ಎಂದು ಅರ್ಥೈಸಬಹುದು, ಮತ್ತು ಒತ್ತಡದ ಏರಿಕೆ ಹವಾಮಾನವು ಸುಧಾರಿಸುತ್ತದೆ ಎಂದು ಅರ್ಥೈಸಬಹುದು. ಒತ್ತಡವನ್ನು ಬ್ಯಾರೊಮೆಟ್ರಿಕ್ ಒತ್ತಡ ಅಥವಾ ವಾತಾವರಣದ ಒತ್ತಡ ಎಂದೂ ಕರೆಯಲಾಗುತ್ತದೆ.";

"AboutHumidity_Title"  = "ಸಾಪೇಕ್ಷ ಆರ್ದ್ರತೆ";
"AboutHumidity_Body"   = "ಸಾಪೇಕ್ಷ ಆರ್ದ್ರತೆ, ಸಾಮಾನ್ಯವಾಗಿ ಆರ್ದ್ರತೆ ಎಂದು ಕರೆಯಲ್ಪಡುತ್ತದೆ, ಇದು ಗಾಳಿಯಲ್ಲಿರುವ ಆರ್ದ್ರತೆಯ ಪ್ರಮಾಣವನ್ನು ಗಾಳಿಯು ಹಿಡಿದಿಟ್ಟುಕೊಳ್ಳುವುದಕ್ಕಿಂತ ಹೋಲಿಸಿದರೆ ಸೂಚಿಸುತ್ತದೆ. ಹೆಚ್ಚಿನ ತಾಪಮಾನದಲ್ಲಿ ಗಾಳಿಯು ಹೆಚ್ಚು ಆರ್ದ್ರತೆಯನ್ನು ಹಿಡಿದಿಟ್ಟುಕೊಳ್ಳಬಹುದು.% mಅಲ್ಲಿ ದೋಸೆ ಅಥವಾ ಮಂಜು ಇರಬಹುದು.";

"AboutDewPoint_Title" = "ದಾವ್ ಪಾಯಿಂಟ್ ಬಗ್ಗೆ";
"AboutDewPoint_Body"  = "ದೋವಿನ ಬಿಂದುವು ದೋವಿನ ರಚನೆಗೆ ತಾಪಮಾನವು ಬೀಳಬೇಕಾಗುತ್ತದೆ. ಇದು ಗಾಳಿಯು ಎಷ್ಟು ಆರ್ದ್ರವಾಗಿದೆ ಎಂಬುದನ್ನು ಹೇಳಲು ಉಪಯುಕ್ತ ಮಾರ್ಗವಾಗಿದೆ  ದೋವಿನ ಬಿಂದುವು ಹೆಚ್ಚು ಎತ್ತರವಾಗುವುದರಿಂದ ಅದು ಹೆಚ್ಚು ಆರ್ದ್ರವಾಗಿರುತ್ತದೆ. ಪ್ರಸ್ತುತ ತಾಪಮಾನಕ್ಕೆ ಹೊಂದಿಕೆಯಾಗುವ ದೋವಿನ ಬಿಂದು ಎಂದರೆ ಸಾಪೇಕ್ಷ ಆರ್ದ್ರತೆ 100% ಆಗಿದೆ, ಮತ್ತು ದೋನಿ ಅಥವಾ ಮಂಜು ಇರಬಹುದು.";

