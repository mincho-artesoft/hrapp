"Promo.WiseEating.description" = "ಬುದ್ಧಿವಂತ ಆಹಾರವು ನಿಮ್ಮ ಬುದ್ಧಿವಂತ ಪೋಷಣೆ ಮತ್ತು ತರಬೇತಿಗಾಗಿ ನಿಮ್ಮ AI ಚಾಲಿತ ತರಬೇತುದಾರ. ಇದು ಆಧುನಿಕ ಪೌಷ್ಟಿಕಾಂಶ ವಿಜ್ಞಾನವನ್ನು ಪ್ರಾಯೋಗಿಕ ಸಾಧನಗಳೊಂದಿಗೆ ಸಂಯೋಜಿಸುತ್ತದೆ, ಅದು ನಿಮಗೆ ಊಟವನ್ನು ಯೋಜಿಸಲು, ವ್ಯಾಯಾಮವನ್ನು ವಿನ್ಯಾಸಗೊಳಿಸಲು, ನಿಮ್ಮ ಸಂಗ್ರಹವನ್ನು ನಿರ್ವಹಿಸಲು ಮತ್ತು ಆಹಾರ ಮತ್ತು ಚಲನೆಯು ನಿಮ್ಮ ದೇಹದ ಮೇಲೆ ಹೇಗೆ ಪರಿಣಾಮ ಬೀರುತ್ತದೆ ಎಂಬುದನ್ನು ಅರ್ಥಮಾಡಿಕೊಳ್ಳಲು ಸಹಾಯ ಮಾಡುತ್ತದೆ.";
"Promo.StoreFront.name" = "ಸ್ಟೋರ್ಫ್ರಂಟ್ ಸ್ಟುಡಿಯೋ";
"Promo.StoreFront.description" = "ಸ್ಟೋರ್ಫ್ರಂಟ್ ಸ್ಟುಡಿಯೋ ಐಒಎಸ್ ಮತ್ತು ಮ್ಯಾಕೋಸ್ ಡೆವಲಪರ್ಗಳಿಗೆ ಉನ್ನತ ಮಟ್ಟದ 3D ವಿನ್ಯಾಸ ಪರಿಸರವಾಗಿದೆ. ಇದು ಪ್ರಬಲವಾದ ರಿಚ್ ಟೆಕ್ಸ್ಟ್ ಸಂಪಾದಕದೊಂದಿಗೆ ಹೆಚ್ಚಿನ ನಿಷ್ಠೆಯನ್ನು ಹೊಂದಿರುವ ರಿಯಾಲಿಟಿ ಕಿಟ್ ರೆಂಡರಿಂಗ್ ಅನ್ನು ಸಂಯೋಜಿಸುತ್ತದೆ. ಇದು ಕಚ್ಚಾ ಸ್ಕ್ರೀನ್ಶಾಟ್ಗಳನ್ನು ವೃತ್ತಿಪರ, ಹೆಚ್ಚು ಪರಿವರ್ತಿಸುವ ಆಪ್ ಸ್ಟೋರ್ ಸ್ವತ್ತುಗಳಾಗಿ ಪರಿವರ್ತಿಸಲು ನಿಮಗೆ ಸಹಾಯ ಮಾಡುತ್ತದೆ.";
"Promo.ReelStudio.name" = "ರಿಲ್ ಸ್ಟುಡಿಯೋ";
"Promo.ReelStudio.description" = "ರೀಲ್ಸ್ಟುಡಿಯೋ ಎನ್ನುವುದು ಐಒಎಸ್ ಮತ್ತು ಮ್ಯಾಕೋಸ್ಗಾಗಿ ಸೃಷ್ಟಿಕರ್ತ-ಗ್ರೇಡ್ ಸ್ಕ್ರೀನ್ ರೆಕಾರ್ಡಿಂಗ್ ಸ್ಟುಡಿಯೋ. ನಿಮ್ಮ ಪರದೆಯ ಮತ್ತು ಕ್ಯಾಮೆರಾದೊಂದಿಗೆ ಏಕಕಾಲದಲ್ಲಿ ಸೆರೆಹಿಡಿಯಿರಿ, ಮೈಕ್ರೋ + ಸಿಸ್ಟಮ್ ಆಡಿಯೊವನ್ನು ನಿಯಂತ್ರಿಸಿ ಮತ್ತು ಟ್ಯುಟೋರಿಯಲ್ಗಳು, ವಾಕ್ಥ್ರೂಗಳು ಮತ್ತು ಉತ್ಪನ್ನ ಡೆಮೊಗಳಿಗಾಗಿ ಕ್ಲೀನ್ ಎಂಪಿ 4 ಗಳನ್ನು ರಫ್ತು ಮಾಡಿ. ಐಒಎಸ್ನಲ್ಲಿ, ನೀವು ಅಪ್ಲಿಕೇಶನ್ನಲ್ಲಿ ವೀಡಿಯೊವನ್ನು ಪ್ಲೇ ಮಾಡಬಹುದು ಮತ್ತು ಪ್ರತಿಕ್ರಿಯೆ ಶೈಲಿಯ ಮತ್ತು ಪ್ರೆಸೆಂಟರ್-ನೇತೃತ್ವದ ವಿಷಯಕ್ಕಾಗಿ ನಿಮ್ಮ ಕ್ಯಾಮೆರಾದೊಂದಿಗೆ ಅದನ್ನು ರೆಕಾರ್ಡ್ ಮಾಡಬಹುದು.";
"Promo.MarketBrief.name" = "ಮಾರುಕಟ್ಟೆ ಬ್ರೀಫ್ AI";
"Promo.MarketBrief.description" = "ಮಾರ್ಕೆಟ್ ಬ್ರೀಫ್ AI ಸಾಧನದಲ್ಲಿನ ವಿಶ್ಲೇಷಣೆ ಮತ್ತು ಶಬ್ದದಿಂದ ಸಿಗ್ನಲ್ ಅನ್ನು ಪ್ರತ್ಯೇಕಿಸಲು ವಿನ್ಯಾಸಗೊಳಿಸಲಾದ ಬಹು-ಏಜೆಂಟ್ ಕೆಲಸದ ಹರಿವಿನೊಂದಿಗೆ ಮಾರುಕಟ್ಟೆ ಚಲನೆಯನ್ನು ಅರ್ಥಮಾಡಿಕೊಳ್ಳಲು ನಿಮಗೆ ಸಹಾಯ ಮಾಡುತ್ತದೆ. ನೈಜ-ಸಮಯದ ಬೆಲೆ ಡೇಟಾವನ್ನು ಟ್ರ್ಯಾಕ್ ಮಾಡಿ, ಆಡಳಿತ ಶೈಲಿಯ ಸಂಭವನೀಯತೆಗಳನ್ನು ಅನ್ವೇಷಿಸಿ ಮತ್ತು ನಿಮ್ಮ ನಿರ್ಧಾರ ತೆಗೆದುಕೊಳ್ಳುವಿಕೆಯನ್ನು ಬೆಂಬಲಿಸಲು ಸ್ಪಷ್ಟ ಡ್ಯಾಶ್ಬೋರ್ಡ್ಗಳು ಮತ್ತು ಚಾರ್ಟ್ಗಳನ್ನು ಬಳಸಿ. ಗೌಪ್ಯತೆ-ಮೊದಲನೆಯದಾಗಿಃ ನಿಮ್ಮ ಸಂರಚನೆಗಳು ನಿಮ್ಮ ಸಾಧನದಲ್ಲಿ ಉಳಿಯುತ್ತವೆ.";

