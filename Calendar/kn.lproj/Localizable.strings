"Promo.FastestScreenshotCleaner.description" = "ವೇಗವಾದ ಸ್ಕ್ರೀನ್‌ಶಾಟ್ ಕ್ಲೀನರ್ ನಿಮ್ಮ ಫೋಟೋ ಲೈಬ್ರರಿಯನ್ನು ಸ್ಕ್ರೀನ್‌ಶಾಟ್‌ಗಳು, ನಕಲುಗಳು ಮತ್ತು ಅಂತಹುದೇ ಕ್ಯಾಪ್ಚರ್‌ಗಳಿಗಾಗಿ ಸ್ಕ್ಯಾನ್ ಮಾಡುತ್ತದೆ. ಎಲ್ಲಾ ವಿಶ್ಲೇಷಣೆಗಳು ನಿಮ್ಮ ಸಾಧನದಲ್ಲಿ ಖಾಸಗಿಯಾಗಿ ಇರುವಾಗ ಉಚಿತ ಸಂಗ್ರಹಣೆಗೆ ತ್ವರಿತವಾಗಿ ಅವುಗಳನ್ನು ಸ್ವಚ್ಛಗೊಳಿಸಿ.";
"Promo.PureStrike.description" = "PureStrike Billiard ನಿಮಗೆ 8-ಬಾಲ್ ಅನ್ನು ಆನ್‌ಲೈನ್‌ನಲ್ಲಿ, AI ವಿರುದ್ಧ ಅಥವಾ ಒಂದು ಸಾಧನದಲ್ಲಿ ಸ್ನೇಹಿತರೊಂದಿಗೆ ಆಡಲು ಅನುಮತಿಸುತ್ತದೆ. ಪ್ರತಿ ಪಂದ್ಯಕ್ಕೂ ಉತ್ತಮವಾದ ಗುರಿ, ಶಕ್ತಿ, ಸ್ಪಿನ್, ಕ್ಯಾಮರಾ ವೀಕ್ಷಣೆಗಳು, ನಿಯಮಗಳು ಮತ್ತು ಶಾಟ್ ಮಾರ್ಗದರ್ಶಿಗಳು.";
"Promo.StarFront.description" = "ಸರ್ವೈವಲ್: ಸ್ಟಾರ್‌ಫ್ರಂಟ್ ಮೂರು-ಲೇನ್ ವೈಜ್ಞಾನಿಕ ರಕ್ಷಣಾ ಆಟವಾಗಿದ್ದು, ಪ್ರತಿಯೊಬ್ಬ ಸೈನಿಕನು ಸ್ವಯಂಚಾಲಿತವಾಗಿ ಗುಂಡು ಹಾರಿಸುವಾಗ ನೀವು ನಿಮ್ಮ ತಂಡವನ್ನು ಲೇನ್‌ಗಳ ನಡುವೆ ಚಲಿಸುತ್ತೀರಿ. ನಿಮ್ಮ ರಚನೆಗೆ ಹೊಂದಿಕೊಳ್ಳಿ ಮತ್ತು ಮುನ್ನಡೆಯುತ್ತಿರುವ ಶತ್ರು ಅಲೆಗಳಿಂದ ಬದುಕುಳಿಯಿರಿ.";
"Promo.PolyCore.description" = "PolyCore TD ಒಂದು ಆರ್ಕೇಡ್ ಟವರ್-ರಕ್ಷಣಾ ಬದುಕುಳಿಯುವ ಆಟವಾಗಿದ್ದು, ಅಲ್ಲಿ ನೀವು ಪಟ್ಟುಬಿಡದ ಜ್ಯಾಮಿತೀಯ ಶತ್ರುಗಳಿಂದ ಕೇಂದ್ರ ಗೋಪುರವನ್ನು ರಕ್ಷಿಸುತ್ತೀರಿ. ನವೀಕರಣಗಳನ್ನು ಗಳಿಸಿ, ಶಸ್ತ್ರಾಸ್ತ್ರಗಳನ್ನು ಸಂಯೋಜಿಸಿ ಮತ್ತು ಪ್ರತಿ ಓಟದ ಸಮಯದಲ್ಲಿ ವಿಭಿನ್ನ ಶಸ್ತ್ರಾಗಾರವನ್ನು ನಿರ್ಮಿಸಿ.";
"Promo.RealtimeAssistant.description" = "GPT ರಿಯಲ್‌ಟೈಮ್ ಅಸಿಸ್ಟೆಂಟ್ ಎನ್ನುವುದು ಬಳಕೆದಾರ-ಪ್ರಾರಂಭಿಸಿದ ಲೈವ್ ಸಂಭಾಷಣೆಗಳಿಗಾಗಿ AI ಉತ್ಪಾದಕತೆಯ ಕಾರ್ಯಸ್ಥಳವಾಗಿದೆ. ಸಭೆಗಳು, ಬುದ್ದಿಮತ್ತೆ, ಅನುವಾದ, ಯೋಜನೆ ಮತ್ತು ಕಲಿಕೆಯ ಸಮಯದಲ್ಲಿ ನೈಜ-ಸಮಯದ ಪ್ರತಿಲೇಖನ, ಸಂದರ್ಭೋಚಿತ ಸಹಾಯ, ಟಿಪ್ಪಣಿಗಳು ಮತ್ತು ಅನುಸರಣಾ ಕ್ರಮಗಳನ್ನು ಬಳಸಿ.";
"Promo.PhotoArchive.description" = "Photo2Video ಆರ್ಕೈವ್ ಮೆಮೊರಿಯನ್ನು ಅಳಿಸದೆಯೇ ಸಂಗ್ರಹಣೆಯನ್ನು ಉಳಿಸಲು ನಿಮಗೆ ಸಹಾಯ ಮಾಡುತ್ತದೆ. ಇದು ಫೋಟೋಗಳನ್ನು ಹೆಚ್ಚು ಸಂಕುಚಿತ ವೀಡಿಯೊ ಆರ್ಕೈವ್‌ಗಳಾಗಿ ಪರಿವರ್ತಿಸುತ್ತದೆ, ದೊಡ್ಡ ಸಂಗ್ರಹಣೆಗಳನ್ನು ಸಂಘಟಿಸಲು ಮತ್ತು ಸಂಗ್ರಹಿಸಲು ಸುಲಭವಾಗುವಂತೆ ನಿಮ್ಮ ವಿಷಯವನ್ನು ಸಂರಕ್ಷಿಸುತ್ತದೆ.";
"Promo.DreamsCalendar.description" = "ಡ್ರೀಮ್ಸ್ ಕ್ಯಾಲೆಂಡರ್ ಒಂದು ಖಾಸಗಿ ಕನಸಿನ ಜರ್ನಲ್, ಮೂಡ್ ಟ್ರ್ಯಾಕರ್ ಮತ್ತು ರಾತ್ರಿ ಮತ್ತು ಹಗಲು ಕನಸುಗಳಿಗಾಗಿ ಪ್ರತಿಫಲನ ಡೈರಿಯಾಗಿದೆ. ಅನುಭವಗಳು ಮತ್ತು ಭಾವನೆಗಳನ್ನು ರೆಕಾರ್ಡ್ ಮಾಡಿ, ನಂತರ ನಿಮ್ಮ ದಿನಗಳು, ನಿದ್ರೆ ಮತ್ತು ಕಲ್ಪನೆಯಾದ್ಯಂತ ಮಾದರಿಗಳನ್ನು ಗಮನಿಸಿ.";
"Promo.LiquidColorPuzzle.description" = "ಲಿಕ್ವಿಡ್ ಕಲರ್ ಪಜಲ್ ಪ್ರಜ್ವಲಿಸುವ ಫ್ಯೂಚರಿಸ್ಟಿಕ್ ಪ್ರಯೋಗಾಲಯದಲ್ಲಿ ವಿಶ್ರಾಂತಿ ವಿಂಗಡಣೆ ಆಟವಾಗಿದೆ. ಪ್ರತಿಯೊಂದು ಪ್ರಯೋಗವು ಹೆಚ್ಚು ಸಂಕೀರ್ಣವಾಗುವುದರಿಂದ ಪ್ರತಿ ಬಣ್ಣವನ್ನು ಪ್ರತ್ಯೇಕಿಸುವವರೆಗೆ ಗಾಜಿನ ಕೊಳವೆಗಳ ನಡುವೆ ಬಣ್ಣದ ದ್ರವಗಳನ್ನು ಸುರಿಯಿರಿ.";
"Promo.GlanceStudio.description" = "ಸಾಮಾಜಿಕ ಮಾಧ್ಯಮ, ಜಾಹೀರಾತು ಮತ್ತು ಕಥೆ ಹೇಳುವಿಕೆಗಾಗಿ ಸಿನಿಮೀಯ ಚಾಟ್-ಶೈಲಿಯ ವೀಡಿಯೊಗಳನ್ನು ರಚಿಸಲು Glance Studio ನಿಮಗೆ ಸಹಾಯ ಮಾಡುತ್ತದೆ. ವಾಸ್ತವಿಕ 3D ಸಾಧನಗಳಲ್ಲಿ ಅನಿಮೇಟೆಡ್ ಸಂಭಾಷಣೆಗಳನ್ನು ನಿರ್ಮಿಸಿ, ಟೈಪಿಂಗ್ ಅನ್ನು ಅನುಕರಿಸಿ, ಮಾಧ್ಯಮವನ್ನು ಲಗತ್ತಿಸಿ ಮತ್ತು ತೊಡಗಿಸಿಕೊಳ್ಳುವ ಲಂಬ ವಿಷಯವನ್ನು ರಫ್ತು ಮಾಡಿ.";
"Promo.Wonek.description" = "Wonek ವೀಡಿಯೊ ಸ್ಟುಡಿಯೋ ಕಚ್ಚಾ ತುಣುಕನ್ನು ಪ್ರಕಟಣೆ-ಸಿದ್ಧ ವಿಷಯವಾಗಿ ಪರಿವರ್ತಿಸುತ್ತದೆ. ಬಲವಾದ ಕ್ಷಣಗಳನ್ನು ಹುಡುಕಿ, ಚೂಪಾದ ಕ್ಲಿಪ್‌ಗಳನ್ನು ರಚಿಸಿ, ಕ್ಲೀನ್ ಉಪಶೀರ್ಷಿಕೆಗಳು ಮತ್ತು ಪಠ್ಯದಿಂದ ಭಾಷಣದ ವಾಯ್ಸ್‌ಓವರ್‌ಗಳನ್ನು ಸೇರಿಸಿ, ನಂತರ ಒಂದು ಕೇಂದ್ರೀಕೃತ ವರ್ಕ್‌ಫ್ಲೋನಲ್ಲಿ ವೀಡಿಯೊ ಮತ್ತು ಆಡಿಯೊವನ್ನು ಪಾಲಿಶ್ ಮಾಡಿ.";
"Promo.GlanceStudioDesktop.description" = "ಗ್ಲಾನ್ಸ್ ಸ್ಟುಡಿಯೋ ಡೆಸ್ಕ್‌ಟಾಪ್ ನಿಮ್ಮ ಮ್ಯಾಕ್‌ಗೆ ಸಿನಿಮೀಯ ಚಾಟ್-ಶೈಲಿಯ ವೀಡಿಯೊ ರಚನೆಯನ್ನು ತರುತ್ತದೆ. ವಾಸ್ತವಿಕ 3D ಸಾಧನಗಳಲ್ಲಿ ಅನಿಮೇಟೆಡ್ ಸಂಭಾಷಣೆಗಳನ್ನು ನಿರ್ಮಿಸಿ, ಟೈಪಿಂಗ್ ಅನ್ನು ಅನುಕರಿಸಿ, ಫೋಟೋಗಳು ಮತ್ತು ವೀಡಿಯೊಗಳನ್ನು ಲಗತ್ತಿಸಿ ಮತ್ತು ಸಾಮಾಜಿಕ ಮಾಧ್ಯಮಕ್ಕಾಗಿ ಲಂಬವಾದ ವಿಷಯವನ್ನು ರಫ್ತು ಮಾಡಿ.";
