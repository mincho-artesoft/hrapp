"Promo.WiseEating.name" = "Wise Eating & Fitness Planner";
"Promo.WiseEating.description" = "Wise Eating es tu coach con IA para comer y entrenar mejor. Combina ciencia nutricional moderna con herramientas prácticas para planificar comidas, diseñar entrenamientos, gestionar tu despensa y entender cómo la comida y el movimiento afectan a tu cuerpo.";
"Promo.StoreFront.name" = "StoreFront Studio";
"Promo.StoreFront.description" = "StoreFront Studio es un entorno de diseño 3D de alto nivel para desarrolladores de iOS y macOS. Combina renderizado RealityKit de alta fidelidad con un editor de texto enriquecido para crear recursos profesionales de App Store.";
"Promo.ReelStudio.name" = "ReelStudio";
"Promo.ReelStudio.description" = "ReelStudio es un estudio de grabación de pantalla para creadores. Captura pantalla y cámara al mismo tiempo, controla micrófono y audio del sistema, y exporta MP4 limpios para tutoriales, recorridos y demos de producto.";
"Promo.MarketBrief.name" = "MarketBrief AI";
"Promo.MarketBrief.description" = "MarketBrief AI te ayuda a entender el movimiento del mercado con análisis en el dispositivo y un flujo multiagente pensado para separar señal y ruido. Sigue precios, probabilidades de régimen y paneles claros para tomar decisiones mejor informadas.";

