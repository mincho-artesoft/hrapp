"Promo.FastestScreenshotCleaner.description" = "வேகமான ஸ்கிரீன்ஷாட் கிளீனர் உங்கள் புகைப்பட நூலகத்தை ஸ்கிரீன் ஷாட்கள், நகல்கள் மற்றும் ஒத்த பிடிப்புகளுக்காக ஸ்கேன் செய்கிறது. அனைத்து பகுப்பாய்வுகளும் உங்கள் சாதனத்தில் தனிப்பட்டதாக இருக்கும் போது, ​​அவற்றை விரைவாகச் சுத்தம் செய்து இலவசச் சேமிப்பகத்தைப் பெறுங்கள்.";
"Promo.PureStrike.description" = "PureStrike Billiard உங்களை 8 பந்துகளை ஆன்லைனில், AI க்கு எதிராக அல்லது ஒரு சாதனத்தில் நண்பர்களுடன் விளையாட அனுமதிக்கிறது. ஒவ்வொரு போட்டிக்கும் சிறந்த இலக்கு, ஆற்றல், சுழல், கேமரா காட்சிகள், விதிகள் மற்றும் ஷாட் வழிகாட்டிகள்.";
"Promo.StarFront.description" = "சர்வைவல்: ஸ்டார்ஃப்ரண்ட் என்பது மூன்று-வழி அறிவியல் புனைகதை விளையாட்டு ஆகும், அங்கு ஒவ்வொரு சிப்பாயும் தானாக சுடும் போது உங்கள் அணியை பாதைகளுக்கு இடையில் நகர்த்துவீர்கள். உங்கள் உருவாக்கத்தை மாற்றியமைத்து, முன்னேறும் எதிரி அலைகளைத் தக்கவைக்கவும்.";
"Promo.PolyCore.description" = "பாலிகோர் டிடி என்பது ஒரு ஆர்கேட் டவர்-டிஃபென்ஸ் உயிர்வாழும் கேம் ஆகும், அங்கு நீங்கள் இடைவிடாத வடிவியல் எதிரிகளிடமிருந்து ஒரு மைய கோபுரத்தைப் பாதுகாக்கிறீர்கள். ஒவ்வொரு ஓட்டத்தின் போதும் மேம்படுத்தல்களைப் பெறுங்கள், ஆயுதங்களை இணைக்கவும் மற்றும் வெவ்வேறு ஆயுதங்களை உருவாக்கவும்.";
"Promo.RealtimeAssistant.description" = "GPT நிகழ்நேர உதவியாளர் என்பது பயனர் தொடங்கும் நேரடி உரையாடல்களுக்கான AI உற்பத்தித்திறன் பணியிடமாகும். கூட்டங்கள், மூளைச்சலவை, மொழிபெயர்ப்பு, திட்டமிடல் மற்றும் கற்றல் ஆகியவற்றின் போது நிகழ்நேர டிரான்ஸ்கிரிப்ஷன், சூழ்நிலை உதவி, குறிப்புகள் மற்றும் பின்தொடர்தல் செயல்களைப் பயன்படுத்தவும்.";
"Promo.PhotoArchive.description" = "Photo2Video காப்பகம் நினைவகங்களை நீக்காமல் சேமிப்பிடத்தை சேமிக்க உதவுகிறது. இது புகைப்படங்களை மிகவும் சுருக்கப்பட்ட வீடியோ காப்பகங்களாக மாற்றுகிறது, பெரிய சேகரிப்புகளை ஒழுங்கமைக்கவும் சேமிக்கவும் எளிதாக்கும் போது உங்கள் உள்ளடக்கத்தைப் பாதுகாக்கிறது.";
"Promo.DreamsCalendar.description" = "ட்ரீம்ஸ் காலெண்டர் என்பது ஒரு தனிப்பட்ட கனவு இதழ், மனநிலை கண்காணிப்பு மற்றும் இரவு மற்றும் பகல் கனவுகளுக்கான பிரதிபலிப்பு நாட்குறிப்பு. அனுபவங்களையும் உணர்ச்சிகளையும் பதிவுசெய்து, உங்கள் நாட்கள், தூக்கம் மற்றும் கற்பனையின் வடிவங்களைக் கவனியுங்கள்.";
"Promo.LiquidColorPuzzle.description" = "திரவ வண்ண புதிர் என்பது ஒளிரும் எதிர்கால ஆய்வகத்தில் ஒரு நிதானமான வரிசையாக்க விளையாட்டு. ஒவ்வொரு பரிசோதனையும் மிகவும் சிக்கலானதாக மாறும்போது ஒவ்வொரு நிறமும் பிரிக்கப்படும் வரை கண்ணாடிக் குழாய்களுக்கு இடையே வண்ண திரவங்களை ஊற்றவும்.";
"Promo.GlanceStudio.description" = "சமூக ஊடகங்கள், விளம்பரம் மற்றும் கதைசொல்லலுக்கான சினிமா அரட்டை பாணி வீடியோக்களை உருவாக்க Glance Studio உங்களுக்கு உதவுகிறது. யதார்த்தமான 3D சாதனங்களுக்குள் அனிமேஷன் உரையாடல்களை உருவாக்கவும், தட்டச்சு செய்வதை உருவகப்படுத்தவும், மீடியாவை இணைக்கவும் மற்றும் செங்குத்து உள்ளடக்கத்தை ஏற்றுமதி செய்யவும்.";
"Promo.Wonek.description" = "Wonek வீடியோ ஸ்டுடியோ மூல காட்சிகளை வெளியிடுவதற்குத் தயாராக இருக்கும் உள்ளடக்கமாக மாற்றுகிறது. வலுவான தருணங்களைக் கண்டறியவும், கூர்மையான கிளிப்களை உருவாக்கவும், சுத்தமான வசனங்கள் மற்றும் உரையிலிருந்து பேச்சு குரல்வழிகளைச் சேர்க்கவும், பின்னர் ஒரு கவனம் செலுத்தும் பணிப்பாய்வுகளில் வீடியோ மற்றும் ஆடியோவை மெருகூட்டவும்.";
"Promo.GlanceStudioDesktop.description" = "க்லான்ஸ் ஸ்டுடியோ டெஸ்க்டாப் உங்கள் மேக்கிற்கு சினிமா அரட்டை பாணி வீடியோ உருவாக்கத்தைக் கொண்டுவருகிறது. யதார்த்தமான 3D சாதனங்களுக்குள் அனிமேஷன் உரையாடல்களை உருவாக்கவும், தட்டச்சு செய்வதை உருவகப்படுத்தவும், புகைப்படங்கள் மற்றும் வீடியோக்களை இணைக்கவும் மற்றும் சமூக ஊடகத்திற்கான செங்குத்து உள்ளடக்கத்தை ஏற்றுமதி செய்யவும்.";
