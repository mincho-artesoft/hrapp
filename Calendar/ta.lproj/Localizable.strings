"Promo.WiseEating.name" = "உணவைப் பற்றிய விவேகமும் உடற்பயிற்சி திட்டமும்";
"Promo.WiseEating.description" = "விஸ் எட்டிங் என்பது உங்கள் AI- இயங்கும் பயிற்சியாளர், புத்திசாலித்தனமான ஊட்டச்சத்து மற்றும் பயிற்சிக்காக. இது நவீன ஊட்டச்சத்து அறிவியலை நடைமுறை கருவிகளுடன் இணைக்கிறது, இது உணவுகளை திட்டமிடவும், பயிற்சிகளை வடிவமைக்கவும், உங்கள் அலமாரியை நிர்வகிக்கவும், உணவு மற்றும் இயக்கங்கள் உங்கள் உடலை எவ்வாறு பாதிக்கின்றன என்பதைப் புரிந்துகொள்ளவும் உதவுகிறது.";
"Promo.StoreFront.name" = "StoreFront ஸ்டுடியோ";
"Promo.StoreFront.description" = "StoreFront Studio என்பது iOS மற்றும் macOS டெவலப்பர்களுக்கான உயர் தரமான 3D வடிவமைப்பு சூழலாகும். இது உயர் விசுவாசமான RealityKit ரெண்டரிங்கை சக்திவாய்ந்த Rich Text ஆசிரியருடன் இணைத்து மூல திரையுலகைகளை தொழில்முறை, உயர் மாற்றும் App Store சொத்துக்களாக மாற்ற உதவுகிறது.";
"Promo.ReelStudio.name" = "ReelStudio";
"Promo.ReelStudio.description" = "ReelStudio என்பது iOS மற்றும் macOS க்கான படைப்பாளர் தர திரை பதிவு ஸ்டுடியோ ஆகும். உங்கள் திரை மற்றும் கேமராவை ஒரே நேரத்தில் கைப்பற்றவும், மைக் + சிஸ்டம் ஆடியோவைக் கட்டுப்படுத்தவும், பயிற்சிகள், நடைமுறைகள் மற்றும் தயாரிப்பு டெமோக்களுக்கான சுத்தமான MP4 களை ஏற்றுமதி செய்யவும். iOS இல், நீங்கள் பயன்பாட்டின் உள்ளே ஒரு வீடியோவை இயக்கலாம் மற்றும் உங்கள் கேமராவுடன் சேர்ந்து பதிவிறக்கம் செய்யலாம்.";
"Promo.MarketBrief.name" = "சந்தை விளக்கமளிப்பு AI";
"Promo.MarketBrief.description" = "MarketBrief AI சாதனத்தில் உள்ள பகுப்பாய்வு மற்றும் சத்தத்திலிருந்து சமிக்ஞையை பிரிப்பதற்காக வடிவமைக்கப்பட்ட பல முகவர் பணிப்பாய்வு மூலம் சந்தை இயக்கத்தை புரிந்துகொள்ள உதவுகிறது. நிகழ்நேர விலை தரவைக் கண்காணிக்கவும், ஆட்சி பாணியில் நிகழ்தகவுகளை ஆராயவும், உங்கள் முடிவெடுப்புக்கு உதவும் தெளிவான டாஷ்போர்டுகள் மற்றும் வரைபடங்களைப் பயன்படுத்தவும். தனியுரிமை-முதலில்ஃ உங்கள் உள்ளமைவுகள் உங்கள் சாதனத்தில் தங்கும்.";

