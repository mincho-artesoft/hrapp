"Promo.WiseEating.name" = "Wise Eating & Fitness Planner";
"Promo.WiseEating.description" = "Wise Eating on tekoälyllä toimiva valmentajasi älykkäämpään ravitsemukseen ja harjoitteluun. Siinä yhdistyvät moderni ravitsemustiede käytännöllisiin työkaluihin, joiden avulla voit suunnitella aterioita, suunnitella harjoituksia, hallita ruokakomeroasi ja ymmärtää, kuinka ruoka ja liike vaikuttavat kehoosi.";
"Promo.StoreFront.name" = "StoreFront Studio";
"Promo.StoreFront.description" = "StoreFront Studio on edistynyt 3D-suunnitteluympäristö iOS- ja macOS-kehittäjille. Se yhdistää tarkan RealityKit-renderöinnin tehokkaaseen muotoillun tekstin editoriin, jolla raakakuvakaappaukset voi muuntaa ammattimaisiksi App Store -materiaaleiksi.";
"Promo.ReelStudio.name" = "ReelStudio";
"Promo.ReelStudio.description" = "ReelStudio on luojatason näytön tallennusstudio iOS ja macOS. Tallenna näyttösi ja kamerasi samaan aikaan, ohjaa mikrofonia ja järjestelmän ääntä ja vie puhtaita MP4-tiedostoja opetusohjelmia, esittelyjä ja tuote-esittelyjä varten. iOS-sovelluksella voit jopa toistaa videon sovelluksen sisällä ja tallentaa sen yhdessä kamerasi kanssa reaktiotyyppistä ja esittäjän ohjaamaa sisältöä varten.";
"Promo.CloudCalendars.name" = "Cloud Calendars";
"Promo.CloudCalendars.description" = "Cloud Calendars yhdistää edistyneen ajoituksen kauniisti integroituihin sääennusteisiin, joten voit suunnitella tarkasti. Se tukee useita kalenteripalveluita, intuitiivista elepohjaista muokkausta, sisäänrakennettuja kokouslinkkejä ja yksityiskohtaisia ​​tunti-/päiväennusteita suoraan aikataulusi sisällä.";
"Promo.MarketBrief.name" = "MarketBrief AI";
"Promo.MarketBrief.description" = "MarketBrief AI auttaa ymmärtämään markkinoiden liikkeitä laitteen sisäisen analytiikan ja usean agentin työnkulun avulla, joka on suunniteltu erottamaan signaalit kohinasta. Seuraa reaaliaikaisia ​​hintatietoja, tutki järjestelmätyylisiä todennäköisyyksiä ja käytä selkeitä kojetauluja ja kaavioita päätöksenteon tueksi. Tietosuoja ensin: määritykset pysyvät laitteessasi.";

