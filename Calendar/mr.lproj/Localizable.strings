"Promo.WiseEating.name" = "बुद्धिमान आहार आणि फिटनेस नियोजन";
"Promo.WiseEating.description" = "Wise Eating हा तुमचा बुद्धिमत्ता युक्त प्रशिक्षक आहे जो तुम्हाला अधिक हुशार पोषण आणि प्रशिक्षण देण्यासाठी मदत करतो. हे आधुनिक पोषण विज्ञान आणि व्यावहारिक साधनांचा संयोजन करते जेणेकरून तुम्ही जेवण नियोजन करू शकाल, व्यायाम डिझाइन करू शकाल, तुमच्या भण्डारात व्यवस्थापित करू शकाल आणि अन्न आणि हालचाली तुमच्या शरीरावर कसा परिणाम करतात हे समजून घ्या.";
"Promo.StoreFront.name" = "StoreFront स्टुडिओ";
"Promo.StoreFront.description" = "StoreFront Studio हा iOS आणि macOS डेव्हलपरसाठी एक उत्कृष्ट 3D डिझाइन वातावरण आहे. हे उच्च-निष्ठता रियलिटीकिट रेन्डरिंगला शक्तिशाली रिच टेक्स्ट संपादकसह एकत्रित करते जे आपल्याला कच्च्या स्क्रीनशॉटला व्यावसायिक, उच्च रूपांतरण अॅप स्टोअर मालमत्तांमध्ये रूपांतरित करण्यात मदत करते.";
"Promo.ReelStudio.name" = "रिअल स्टुडिओ";
"Promo.ReelStudio.description" = "ReelStudio हा iOS आणि macOS साठी क्रिएटर-ग्रेड स्क्रीन रेकॉर्डिंग स्टुडिओ आहे. एकाच वेळी आपली स्क्रीन आणि कॅमेरा कॅप्चर करा, मायक्रो + सिस्टम ऑडिओ नियंत्रित करा आणि ट्यूटोरियल, वॉकथ्रू आणि उत्पादन डेमोसाठी स्वच्छ एमपी 4 निर्यात करा. iOS वर, आपण अॅपमध्ये व्हिडिओ देखील प्ले करू शकता आणि प्रतिसाद शैली आणि प्रस्तुतकर्ता-नेतृत्वित सामग्रीसाठी आपल्या कॅमेर्यासह रेकॉर्ड करू शकता.";
"Promo.MarketBrief.name" = "मार्केटब्रीफ एआय";
"Promo.MarketBrief.description" = "मार्केटब्रीफ एआय आपल्याला डिव्हाइसवरील विश्लेषणासह बाजारपेठेतील हालचाली समजून घेण्यास आणि ध्वनीपासून सिग्नल वेगळे करण्यासाठी डिझाइन केलेले मल्टी-एजंट वर्कफ्लोसह मदत करते. रिअल-टाइम किंमत डेटा ट्रॅक करा, रेझिम-स्टाईल संभाव्यतांचा शोध घ्या आणि निर्णय घेण्यास समर्थन देण्यासाठी स्पष्ट डॅशबोर्ड आणि चार्ट वापरा. गोपनीयता-प्रथमः आपली कॉन्फिगरेशन आपल्या डिव्हाइसवर राहते.";

