"Promo.StoreFront.name" = "StoreFront Studio";
"Promo.StoreFront.description" = "StoreFront Studio היא סביבת עיצוב תלת־ממד מתקדמת למפתחי iOS ו־macOS. היא משלבת עיבוד מדויק באמצעות RealityKit עם עורך רב־עוצמה לטקסט מעוצב, כדי להפוך צילומי מסך גולמיים לחומרים מקצועיים עבור App Store.";
"Promo.ReelStudio.name" = "ReelStudio";
"Promo.ReelStudio.description" = "ReelStudio הוא אולפן הקלטות מסך בדרגת יוצר עבור iOS ו- macOS. צלם את המסך והמצלמה שלך בו-זמנית, שלט במיקרופון + אודיו של המערכת ויצא קובצי MP4 נקיים להדרכות, הדרכה והדגמות מוצר. ב-iOS, אתה יכול אפילו להפעיל סרטון בתוך האפליקציה ולהקליט אותו יחד עם המצלמה שלך לתוכן בסגנון תגובה ותוכן בהנחיית מגישים.";
"Promo.CloudCalendars.name" = "Cloud Calendars";
"Promo.CloudCalendars.description" = "Cloud Calendars משלב תזמון מתקדם עם תחזיות מזג אוויר משולבות להפליא, כך שתוכל לתכנן בדיוק. הוא תומך במספר שירותי לוח שנה, עריכה אינטואיטיבית המבוססת על מחוות, קישורי פגישות מובנים ותחזיות מפורטות לפי שעות/יומיות ישירות בתוך לוח הזמנים שלך.";
"Promo.MarketBrief.name" = "MarketBrief AI";
"Promo.MarketBrief.description" = "MarketBrief AI עוזר לך להבין את תנועת השוק עם ניתוח במכשיר וזרימת עבודה מרובה סוכנים שנועדה להפריד בין אות לרעש. עקוב אחר נתוני מחירים בזמן אמת, חקור הסתברויות בסגנון משטר, והשתמש בלוחות מחוונים ותרשימים ברורים כדי לתמוך בקבלת ההחלטות שלך. הפרטיות תחילה: התצורות שלך נשארות במכשיר שלך.";

