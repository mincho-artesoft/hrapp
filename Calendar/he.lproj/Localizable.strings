"Promo.FastestScreenshotCleaner.description" = "Fastest Screenshot Cleaner סורק את ספריית התמונות שלך לאיתור צילומי מסך, כפילויות ודומות. נקה אותם במהירות לאחסון פנוי בזמן שכל הניתוחים נשארים פרטיים במכשיר שלך.";
"Promo.PureStrike.description" = "PureStrike Billiard מאפשר לך לשחק 8 כדורים באינטרנט, נגד AI, או עם חברים במכשיר אחד. כוונן כיוון, כוח, ספין, תצוגות מצלמה, חוקים ומדריכי ירי לכל משחק.";
"Promo.StarFront.description" = "הישרדות: StarFront הוא משחק מדע בדיוני בעל שלושה נתיבים שבו אתה מעביר את הנבחרת שלך בין נתיבים בזמן שכל חייל יורה אוטומטית. התאם את המבנה שלך ושרוד את גלי האויב המתקדמים.";
"Promo.PolyCore.description" = "PolyCore TD הוא משחק הישרדות במגדל ארקייד שבו אתה מגן על צריח מרכזי מפני אויבים גיאומטריים בלתי פוסקים. הרוויחו שדרוגים, שלבו כלי נשק ובנו ארסנל שונה במהלך כל ריצה.";
"Promo.RealtimeAssistant.description" = "GPT Realtime Assistant הוא סביבת עבודה של פרודוקטיביות בינה מלאכותית לשיחות חיות שהתחילו משתמשים. השתמש בתמלול בזמן אמת, סיוע הקשרי, הערות ופעולות מעקב במהלך פגישות, סיעור מוחות, תרגום, תכנון ולמידה.";
"Promo.PhotoArchive.description" = "Photo2Video Archive עוזר לך לחסוך באחסון מבלי למחוק זיכרונות. זה הופך תמונות לארכיוני וידאו דחוסים מאוד, שומר על התוכן שלך תוך שמירה על אוספים גדולים יותר לארגון ואחסון.";
"Promo.DreamsCalendar.description" = "יומן חלומות הוא יומן חלומות פרטי, גשש מצבי רוח ויומן השתקפות לחלומות לילה ויום. רשמו חוויות ורגשות, ואז שימו לב לדפוסים לאורך הימים, השינה והדמיון שלכם.";
"Promo.LiquidColorPuzzle.description" = "Liquid Color Puzzle הוא משחק מיון מרגיע במעבדה עתידנית זוהרת. יוצקים נוזלים צבעוניים בין צינורות זכוכית עד שכל צבע מופרד ככל שכל ניסוי הופך מורכב יותר.";
"Promo.GlanceStudio.description" = "Glance Studio עוזר לך ליצור סרטונים בסגנון צ'אט קולנועי עבור מדיה חברתית, פרסום וסיפור סיפורים. בנה שיחות מונפשות בתוך התקני תלת מימד מציאותיים, הדמה הקלדה, צרף מדיה וייצא תוכן אנכי מרתק.";
"Promo.Wonek.description" = "Wonek Video Studio הופך מדה גולמית לתוכן מוכן לפרסום. מצא רגעים חזקים, צור קליפים חדים, הוסף כתוביות נקיות וקריינות טקסט לדיבור, ואז ליטוש וידאו ואודיו בזרימת עבודה אחת ממוקדת.";
"Promo.GlanceStudioDesktop.description" = "Glance Studio Desktop מביא יצירת וידאו בסגנון צ'אט קולנועי ל-Mac שלך. בנה שיחות מונפשות בתוך מכשירי תלת מימד מציאותיים, הדמה הקלדה, צרף תמונות וסרטונים וייצא תוכן אנכי עבור מדיה חברתית.";
