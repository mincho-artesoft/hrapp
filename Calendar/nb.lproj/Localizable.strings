"Promo.WiseEating.name" = "Wise Eating & Fitness Planner";
"Promo.WiseEating.description" = "Wise Eating er din AI-drevne coach for smartere ernæring og trening. Den kombinerer moderne ernæringsvitenskap med praktiske verktøy for å hjelpe deg med å planlegge måltider, designe treningsøkter, administrere pantryet ditt og forstå hvordan mat og bevegelse påvirker kroppen din.";
"Promo.StoreFront.name" = "StoreFront Studio";
"Promo.StoreFront.description" = "StoreFront Studio er et avansert 3D-designmiljø for iOS- og macOS-utviklere. Det kombinerer presis RealityKit-gjengivelse med et kraftig redigeringsprogram for formatert tekst, slik at rå skjermbilder kan gjøres om til profesjonelt App Store-materiale.";
"Promo.ReelStudio.name" = "ReelStudio";
"Promo.ReelStudio.description" = "ReelStudio er skjermopptaksstudioet av skapergrad for iOS og macOS. Ta opp skjermen og kameraet samtidig, kontroller mikrofon + systemlyd, og eksporter rene MP4-er for veiledninger, gjennomganger og produktdemoer. På iOS kan du til og med spille av en video inne i appen og ta den opp sammen med kameraet ditt for reaksjonsstil og presentasjonsledet innhold.";
"Promo.MarketBrief.name" = "MarketBrief AI";
"Promo.MarketBrief.description" = "MarketBrief AI hjelper deg å forstå markedsbevegelser med analyse på enheten og en arbeidsflyt med flere agenter designet for å skille signal fra støy. Spor prisdata i sanntid, utforsk sannsynligheter i regimestil, og bruk klare dashboards og diagrammer for å støtte beslutningstakingen din. Personvern først: konfigurasjonene dine forblir på enheten din.";

