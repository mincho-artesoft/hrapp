"Promo.WiseEating.name" = "Wise Eating & Fitness Planner";
"Promo.WiseEating.description" = "Wise Eating je váš trenér s umělou inteligencí pro chytřejší výživu a trénink. Kombinuje moderní vědu o výživě s praktickými nástroji, které vám pomohou naplánovat jídlo, navrhnout cvičení, spravovat spíž a pochopit, jak jídlo a pohyb ovlivňují vaše tělo.";
"Promo.StoreFront.name" = "StoreFront Studio";
"Promo.StoreFront.description" = "StoreFront Studio je pokročilé 3D návrhové prostředí pro vývojáře iOS a macOS. Kombinuje přesné vykreslování RealityKit s výkonným editorem formátovaného textu, který pomáhá proměnit neupravené snímky obrazovky v profesionální materiály pro App Store.";
"Promo.ReelStudio.name" = "ReelStudio";
"Promo.ReelStudio.description" = "ReelStudio je studio pro nahrávání obrazovky na úrovni tvůrců pro iOS a macOS. Zachyťte obrazovku a kameru současně, ovládejte mikrofon + systémový zvuk a exportujte čisté MP4 pro výukové programy, návody a ukázky produktů. Na iOS můžete dokonce přehrávat video v aplikaci a nahrávat je spolu s kamerou pro reakční styl a obsah vedený prezentujícím.";
"Promo.MarketBrief.name" = "MarketBrief AI";
"Promo.MarketBrief.description" = "MarketBrief AI vám pomůže porozumět pohybu trhu pomocí analýzy na zařízení a víceagentního pracovního postupu navrženého k oddělení signálu od šumu. Sledujte údaje o cenách v reálném čase, prozkoumejte pravděpodobnosti ve stylu režimu a používejte přehledné řídicí panely a grafy k podpoře vašeho rozhodování. Ochrana osobních údajů: vaše konfigurace zůstanou na vašem zařízení.";

