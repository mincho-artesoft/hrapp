<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>Event will occur every %ld days.</key>
	<dict>
		<key>NSStringLocalizedFormatKey</key>
		<string>%#@value@</string>
		<key>value</key>
		<dict>
			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>ld</string>
			<key>one</key>
			<string>Az esemény %ld naponta fog ismétlődni.</string>
			<key>other</key>
			<string>Az esemény %ld naponta fog ismétlődni.</string>
		</dict>
	</dict>
	<key>Event will occur every %ld months on the %@ %@.</key>
	<dict>
		<key>NSStringLocalizedFormatKey</key>
		<string>%#@value@</string>
		<key>value</key>
		<dict>
			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>ld</string>
			<key>one</key>
			<string>Az esemény minden %ld. hónapban ekkor fog ismétlődni: %@ %@.</string>
			<key>other</key>
			<string>Az esemény minden %ld. hónapban ekkor fog ismétlődni: %@ %@.</string>
		</dict>
	</dict>
	<key>Event will occur every %ld months on the %@.</key>
	<dict>
		<key>NSStringLocalizedFormatKey</key>
		<string>%#@value@</string>
		<key>value</key>
		<dict>
			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>ld</string>
			<key>one</key>
			<string>Az esemény minden %ld. hónap %@ napján fog ismétlődni.</string>
			<key>other</key>
			<string>Az esemény minden %ld. hónap %@ napján fog ismétlődni.</string>
		</dict>
	</dict>
	<key>Event will occur every %ld months.</key>
	<dict>
		<key>NSStringLocalizedFormatKey</key>
		<string>%#@value@</string>
		<key>value</key>
		<dict>
			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>ld</string>
			<key>one</key>
			<string>Az esemény %ld havonta fog ismétlődni.</string>
			<key>other</key>
			<string>Az esemény %ld havonta fog ismétlődni.</string>
		</dict>
	</dict>
	<key>Event will occur every %ld weeks on %@.</key>
	<dict>
		<key>NSStringLocalizedFormatKey</key>
		<string>%#@value@</string>
		<key>value</key>
		<dict>
			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>ld</string>
			<key>one</key>
			<string>Az esemény minden %ld. héten ekkor fog ismétlődni: %@.</string>
			<key>other</key>
			<string>Az esemény minden %ld. héten ekkor fog ismétlődni: %@.</string>
		</dict>
	</dict>
	<key>Event will occur every %ld weeks.</key>
	<dict>
		<key>NSStringLocalizedFormatKey</key>
		<string>%#@value@</string>
		<key>value</key>
		<dict>
			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>ld</string>
			<key>one</key>
			<string>Az esemény %ld hetente fog ismétlődni.</string>
			<key>other</key>
			<string>Az esemény %ld hetente fog ismétlődni.</string>
		</dict>
	</dict>
	<key>Event will occur every %ld years in %@.</key>
	<dict>
		<key>NSStringLocalizedFormatKey</key>
		<string>%#@value@</string>
		<key>value</key>
		<dict>
			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>ld</string>
			<key>one</key>
			<string>Az esemény minden %ld. évben %@ hónapban fog ismétlődni.</string>
			<key>other</key>
			<string>Az esemény minden %ld. évben %@ hónapban fog ismétlődni.</string>
		</dict>
	</dict>
	<key>Event will occur every %ld years.</key>
	<dict>
		<key>NSStringLocalizedFormatKey</key>
		<string>%#@value@</string>
		<key>value</key>
		<dict>
			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>ld</string>
			<key>one</key>
			<string>Az esemény %ld évente fog ismétlődni.</string>
			<key>other</key>
			<string>Az esemény %ld évente fog ismétlődni.</string>
		</dict>
	</dict>
	<key>every n years on a specific day of months</key>
	<dict>
		<key>NSStringLocalizedFormatKey</key>
		<string>%#@value@</string>
		<key>value</key>
		<dict>
			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>ld</string>
			<key>one</key>
			<string>Az esemény minden %1$ld. évben ekkor fog ismétlődni: %4$@, %2$@ %3$@.</string>
			<key>other</key>
			<string>Az esemény minden %1$ld. évben ekkor fog ismétlődni: %4$@, %2$@ %3$@.</string>
		</dict>
	</dict>
</dict>
</plist>
