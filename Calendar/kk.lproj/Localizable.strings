"Promo.WiseEating.description" = "Wise Eating - ақылды тамақтану мен жаттығуларға арналған AI-мен жұмыс істейтін жаттықтырушы. Ол тамақтануды жоспарлауға, жаттығуларды жобалауға, қоймаңызды басқаруға және тағам мен қозғалыстың денеңізге қалай әсер ететінін түсінуге көмектесетін заманауи тамақтану ғылымын практикалық құралдармен біріктіреді.";
"Promo.StoreFront.name" = "StoreFront Studio";
"Promo.StoreFront.description" = "StoreFront Studio — iOS және macOS әзірлеушілеріне арналған элиталық 3D дизайн ортасы. Ол өңделмеген скриншоттарды кәсіби, жоғары түрлендіретін App Store активтеріне түрлендіруге көмектесу үшін жоғары дәлдіктегі RealityKit көрсетуді қуатты Rich Text өңдегішімен біріктіреді.";
"Promo.ReelStudio.name" = "ReelStudio";
"Promo.ReelStudio.description" = "ReelStudio — iOS және macOS жүйелеріне арналған жасаушылар деңгейіндегі экран жазу студиясы. Экран мен камераны бір уақытта түсіріңіз, микрофон + жүйелік дыбысты басқарыңыз және оқулықтар, нұсқаулықтар және өнімнің демонстрациялары үшін таза MP4 файлдарын экспорттаңыз. iOS жүйесінде сіз тіпті қолданбаның ішінде бейнені ойнатып, оны реакция стилі мен баяндамашы басқаратын мазмұн үшін камерамен бірге жаза аласыз.";
"Promo.MarketBrief.name" = "MarketBrief AI";
"Promo.MarketBrief.description" = "MarketBrief AI сигналды шудан бөлуге арналған құрылғыдағы аналитика және көп агентті жұмыс процесі арқылы нарық қозғалысын түсінуге көмектеседі. Нақты уақыттағы баға деректерін қадағалаңыз, режим стиліндегі ықтималдықтарды зерттеңіз және шешім қабылдауды қолдау үшін анық бақылау тақталары мен диаграммаларды пайдаланыңыз. Біріншіден, құпиялылық: конфигурацияларыңыз құрылғыңызда қалады.";

