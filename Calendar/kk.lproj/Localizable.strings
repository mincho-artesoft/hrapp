"Promo.FastestScreenshotCleaner.description" = "Ең жылдам скриншот тазалау құралы скриншоттарды, көшірмелерді және ұқсас түсірілімдерді табу үшін фото кітапханаңызды сканерлейді. Барлық талдаулар құрылғыңызда жеке қалады, ал жадты босату үшін оларды жылдам тазалаңыз.";
"Promo.PureStrike.description" = "PureStrike бильярд 8 допты онлайн, AI-ға қарсы немесе достарыңызбен бір құрылғыда ойнауға мүмкіндік береді. Әрбір матч үшін мақсатты, қуатты, айналдыруды, камера көріністерін, ережелерді және түсіру нұсқаулықтарын дәл баптаңыз.";
"Promo.StarFront.description" = "Аман қалу: StarFront - бұл үш жолақты ғылыми-фантастикалық қорғаныс ойыны, онда әр сарбаз автоматты түрде атыс кезінде өз тобыңызды жолақтар арасында жылжытасыз. Құрылымыңызды бейімдеңіз және келе жатқан жау толқындарынан аман өтіңіз.";
"Promo.PolyCore.description" = "PolyCore TD - орталық мұнараны тынымсыз геометриялық жаулардан қорғайтын аркадалық мұнарадан қорғану ойыны. Жаңартулар алыңыз, қаруларды біріктіріңіз және әр жүгіру кезінде басқа арсенал жасаңыз.";
"Promo.RealtimeAssistant.description" = "GPT Realtime Assistant — пайдаланушы бастаған тікелей сөйлесулерге арналған AI өнімділігінің жұмыс кеңістігі. Кездесулер, миға шабуыл, аударма, жоспарлау және оқу кезінде нақты уақыттағы транскрипцияны, контекстік көмекті, жазбаларды және кейінгі әрекеттерді пайдаланыңыз.";
"Promo.PhotoArchive.description" = "Photo2Video Archive жадты жоймай жадты сақтауға көмектеседі. Ол фотосуреттерді жоғары қысылған бейне мұрағаттарына түрлендіреді, мазмұнды сақтай отырып, үлкен жинақтарды ұйымдастыруды және сақтауды жеңілдетеді.";
"Promo.DreamsCalendar.description" = "Dreams Calendar — түнгі және күндізгі армандарға арналған жеке арман журналы, көңіл-күйді бақылаушы және рефлексия күнделігі. Тәжірибелер мен эмоцияларды жазып алыңыз, содан кейін күндеріңіздің, ұйқыңыздың және қиялыңыздың үлгілерін байқаңыз.";
"Promo.LiquidColorPuzzle.description" = "Liquid Color Puzzle - жарқыраған футуристік зертханадағы босаңсытатын сұрыптау ойыны. Әр тәжірибе күрделене түскен сайын әр түс бөлінгенше шыны түтіктердің арасына түсті сұйықтықтарды құйыңыз.";
"Promo.GlanceStudio.description" = "Glance Studio әлеуметтік медиа, жарнама және әңгімелер үшін кинематографиялық чат стиліндегі бейнелерді жасауға көмектеседі. Шынайы 3D құрылғыларының ішінде анимациялық сөйлесулер жасаңыз, теруді имитациялаңыз, медианы тіркеңіз және тартымды тік мазмұнды экспорттаңыз.";
"Promo.Wonek.description" = "Wonek бейне студиясы өңделмеген кадрларды жариялауға дайын мазмұнға айналдырады. Күшті сәттерді табыңыз, өткір клиптер жасаңыз, таза субтитрлерді және мәтінді дыбысқа дауысты қосуды қосыңыз, содан кейін бір мақсатты жұмыс процесінде бейне мен дыбысты жылтыратыңыз.";
"Promo.GlanceStudioDesktop.description" = "Glance Studio Desktop Mac компьютеріңізге кинематографиялық чат стиліндегі бейне жасауды ұсынады. Шынайы 3D құрылғыларының ішінде анимациялық сөйлесулер жасаңыз, теруді имитациялаңыз, фотосуреттер мен бейнелерді тіркеңіз және әлеуметтік медиа үшін тік мазмұнды экспорттаңыз.";
