"Promo.WiseEating.name" = "Wise Eating & Fitness Planner";
"Promo.WiseEating.description" = "Wise Eating to Twój trener oparty na sztucznej inteligencji, który pomoże Ci mądrzej odżywiać się i trenować. Łączy w sobie nowoczesną naukę o żywieniu z praktycznymi narzędziami, które pomogą Ci planować posiłki, projektować treningi, zarządzać spiżarnią i zrozumieć, jak jedzenie i ruch wpływają na Twój organizm.";
"Promo.StoreFront.name" = "StoreFront Studio";
"Promo.StoreFront.description" = "StoreFront Studio to zaawansowane środowisko projektowania 3D dla programistów iOS i macOS. Łączy precyzyjne renderowanie RealityKit z wydajnym edytorem tekstu sformatowanego, aby przekształcać surowe zrzuty ekranu w profesjonalne materiały do App Store.";
"Promo.ReelStudio.name" = "ReelStudio";
"Promo.ReelStudio.description" = "ReelStudio to studio nagrań ekranowych klasy twórczej dla iOS i macOS. Przechwytuj jednocześnie ekran i kamerę, steruj mikrofonem i dźwiękiem systemowym oraz eksportuj czyste pliki MP4 do samouczków, instruktaży i demonstracji produktów. Na iOS możesz nawet odtwarzać wideo w aplikacji i nagrywać je razem z kamerą, aby uzyskać treści w stylu reakcji i prowadzone przez prezentera.";
"Promo.CloudCalendars.name" = "Cloud Calendars";
"Promo.CloudCalendars.description" = "Cloud Calendars łączy zaawansowane planowanie z pięknie zintegrowanymi prognozami pogody, dzięki czemu możesz planować z precyzją. Obsługuje wiele usług kalendarza, intuicyjną edycję opartą na gestach, wbudowane łącza do spotkań i szczegółowe prognozy godzinowe/dzienne bezpośrednio w harmonogramie.";
"Promo.MarketBrief.name" = "MarketBrief AI";
"Promo.MarketBrief.description" = "MarketBrief AI pomaga zrozumieć ruch na rynku dzięki analizom na urządzeniu i wieloagentowemu przepływowi pracy zaprojektowanemu w celu oddzielenia sygnału od szumu. Śledź dane cenowe w czasie rzeczywistym, badaj prawdopodobieństwa w stylu reżimu i korzystaj z przejrzystych pulpitów nawigacyjnych i wykresów wspierających proces decyzyjny. Prywatność przede wszystkim: Twoje konfiguracje pozostają na Twoim urządzeniu.";

