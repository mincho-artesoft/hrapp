"Promo.ReelStudio.name" = "ReelStudio";
"Promo.ReelStudio.description" = "ReelStudio là phòng thu màn hình dành cho người sáng tạo dành cho iOS và macOS. Chụp màn hình và máy ảnh của bạn cùng lúc, điều khiển micrô + âm thanh hệ thống và xuất các tệp MP4 sạch để làm hướng dẫn, hướng dẫn và demo sản phẩm. Trên iOS, bạn thậm chí có thể phát video bên trong ứng dụng và ghi lại video đó bằng máy ảnh của mình để có nội dung theo phong cách phản ứng và do người thuyết trình dẫn dắt.";
"Promo.MarketBrief.name" = "MarketBrief AI";
