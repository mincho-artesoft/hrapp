"Promo.WiseEating.name" = "വിവേകമുള്ള ഭക്ഷണവും വ്യായാമവും";
"Promo.WiseEating.description" = "വിസ് എറ്റ് നിങ്ങളുടെ ബുദ്ധിശക്തിയുള്ള പോഷകാഹാര പരിശീലന പരിശീലകനാണ്. ആധുനിക പോഷകാഹാര ശാസ്ത്രത്തെ പ്രായോഗിക ഉപകരണങ്ങളുമായി സംയോജിപ്പിച്ച് ഭക്ഷണക്രമം ആസൂത്രണം ചെയ്യാനും വ്യായാമങ്ങൾ രൂപകൽപ്പന ചെയ്യാനും നിങ്ങളുടെ അങ്കി നിയന്ത്രിക്കാനും ഭക്ഷണവും ചലനവും നിങ്ങളുടെ ശരീരത്തെ എങ്ങനെ ബാധിക്കുന്നുവെന്ന് മനസിലാക്കാനും സഹായിക്കുന്നു.";
"Promo.StoreFront.name" = "സ്റ്റോര് ഫ്രണ്ട് സ്റ്റുഡിയോ";
"Promo.StoreFront.description" = "ഐഒഎസ്, മാകോസ് ഡവലപ്പർമാർക്ക് വേണ്ടിയുള്ള മികച്ച 3D ഡിസൈൻ പരിതസ്ഥിതിയാണ് സ്റ്റോർഫ്രണ്ട് സ്റ്റുഡിയോ. ഇത് ഉയർന്ന ഫിഡലിറ്റി റിയാലിറ്റി കിറ്റ് റെൻഡറിംഗും ശക്തമായ റിച്ചി ടെക്സ്റ്റ് എഡിറ്ററുമായും സംയോജിപ്പിച്ച് അസംസ്കൃത സ്ക്രീൻഷോട്ടുകൾ പ്രൊഫഷണൽ, ഉയർന്ന പരിവർത്തന ആപ്പ് സ്റ്റോർ അസറ്റുകളാക്കി മാറ്റാൻ സഹായിക്കുന്നു.";
"Promo.ReelStudio.name" = "റീല് സ്റ്റുഡിയോ";
"Promo.ReelStudio.description" = "ഐഒഎസ്, മാകോസ് എന്നിവയ്ക്കായുള്ള ക്രിയേറ്റർ ഗ്രേഡ് സ്ക്രീൻ റെക്കോർഡിംഗ് സ്റ്റുഡിയോയാണ് റീൽസ്റ്റുഡിയോ. ഒരേ സമയം നിങ്ങളുടെ സ്ക്രീനും ക്യാമറയും പകർത്തുക, മൈക്രോ + സിസ്റ്റം ഓഡിയോ നിയന്ത്രിക്കുക, ട്യൂട്ടോറിയലുകൾ, വാക്ക് ത്രൂകൾ, ഉൽപ്പന്ന ഡെമോകൾ എന്നിവയ്ക്കായി ശുദ്ധമായ എംപി 4 എക്സ്പോർട്ട് ചെയ്യുക. ഐഒഎസ് ഉപയോഗിച്ച് നിങ്ങൾക്ക് ആപ്ലിക്കേഷനുള്ളിൽ ഒരു വീഡിയോ പ്ലേ ചെയ്യാനും നിങ്ങളുടെ ക്യാമറയ്ക്കൊപ്പം റെക്കോർഡുചെയ്യാനും കഴിയും.";
"Promo.MarketBrief.name" = "മാർക്കറ്റ് ബ്രീഫ് AI";
"Promo.MarketBrief.description" = "മാർക്കറ്റ് ബ്രീഫ് AI ഉപകരണം ഉള്ളിലെ അനലിറ്റിക്സ്, ശബ്ദത്തിൽ നിന്ന് സിഗ്നൽ വേർതിരിക്കുന്നതിന് രൂപകൽപ്പന ചെയ്ത മൾട്ടി-ഏജന്റ് വർക്ക്ഫ്ലോ എന്നിവ ഉപയോഗിച്ച് വിപണി ചലനം മനസിലാക്കാൻ നിങ്ങളെ സഹായിക്കുന്നു. തത്സമയ വില ഡാറ്റ ട്രാക്കുചെയ്യുക, റെജിം ശൈലിയിലുള്ള സാധ്യതകൾ പര്യവേക്ഷണം ചെയ്യുക, നിങ്ങളുടെ തീരുമാനമെടുക്കൽ പിന്തുണയ്ക്കുന്നതിന് വ്യക്തമായ ഡാഷ്ബോർഡുകളും ചാർട്ടുകളും ഉപയോഗിക്കുക. സ്വകാര്യത-ആദ്യംഃ നിങ്ങളുടെ കോൺഫിഗറേഷനുകൾ നിങ്ങളുടെ ഉപകരണത്തിൽ തുടരുന്നു.";

