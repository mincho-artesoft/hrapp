"Promo.WiseEating.name" = "Wise Eating & Fitness Planner";
"Promo.WiseEating.description" = "बेहतर पोषण और प्रशिक्षण के लिए वाइज ईटिंग आपका एआई-संचालित कोच है। यह आधुनिक पोषण विज्ञान को व्यावहारिक उपकरणों के साथ जोड़ता है ताकि आपको भोजन की योजना बनाने, वर्कआउट डिजाइन करने, अपनी पेंट्री प्रबंधित करने और यह समझने में मदद मिल सके कि भोजन और गतिविधि आपके शरीर को कैसे प्रभावित करते हैं।";
"Promo.StoreFront.name" = "StoreFront Studio";
"Promo.StoreFront.description" = "StoreFront Studio, iOS और macOS डेवलपर के लिए एक उन्नत 3D डिज़ाइन परिवेश है। यह सटीक RealityKit रेंडरिंग को शक्तिशाली स्वरूपित-पाठ संपादक के साथ जोड़ता है, ताकि कच्चे स्क्रीनशॉट को पेशेवर App Store सामग्री में बदला जा सके।";
"Promo.ReelStudio.name" = "ReelStudio";
"Promo.ReelStudio.description" = "ReelStudio, iOS और macOS के लिए क्रिएटर-ग्रेड स्क्रीन रिकॉर्डिंग स्टूडियो है। एक ही समय में अपनी स्क्रीन और कैमरे को कैप्चर करें, माइक + सिस्टम ऑडियो को नियंत्रित करें, और ट्यूटोरियल, वॉकथ्रू और उत्पाद डेमो के लिए स्वच्छ MP4 निर्यात करें। iOS पर, आप ऐप के अंदर एक वीडियो भी चला सकते हैं और प्रतिक्रिया-शैली और प्रस्तुतकर्ता-आधारित सामग्री के लिए इसे अपने कैमरे के साथ रिकॉर्ड कर सकते हैं।";
"Promo.CloudCalendars.name" = "Cloud Calendars";
"Promo.CloudCalendars.description" = "Cloud Calendars खूबसूरती से एकीकृत मौसम पूर्वानुमान के साथ उन्नत शेड्यूलिंग को जोड़ती है, ताकि आप सटीकता के साथ योजना बना सकें। यह कई कैलेंडर सेवाओं, सहज ज्ञान युक्त इशारा-आधारित संपादन, अंतर्निहित मीटिंग लिंक और सीधे आपके शेड्यूल के अंदर विस्तृत प्रति घंटा/दैनिक पूर्वानुमान का समर्थन करता है।";
"Promo.MarketBrief.name" = "MarketBrief AI";
"Promo.MarketBrief.description" = "MarketBrief AI आपको ऑन-डिवाइस एनालिटिक्स और सिग्नल को शोर से अलग करने के लिए डिज़ाइन किए गए मल्टी-एजेंट वर्कफ़्लो के साथ बाज़ार की हलचल को समझने में मदद करता है। वास्तविक समय मूल्य डेटा को ट्रैक करें, शासन-शैली की संभावनाओं का पता लगाएं, और अपने निर्णय लेने में सहायता के लिए स्पष्ट डैशबोर्ड और चार्ट का उपयोग करें। गोपनीयता-प्रथम: आपकी कॉन्फ़िगरेशन आपके डिवाइस पर रहती है।";

