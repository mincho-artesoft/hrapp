<dict>
	<key>Event will occur every %ld days.</key>
	<dict>
		<key>NSStringLocalizedFormatKey</key>
		<string>%#@value@</string>
		<key>value</key>
		<dict>
			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>ld</string>
			<key>one</key>
			<string>इवेंट हर %ld दिन पर होगा।</string>
			<key>other</key>
			<string>इवेंट हर %ld दिन पर होगा।</string>
		</dict>
	</dict>
