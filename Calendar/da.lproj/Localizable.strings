"Promo.WiseEating.name" = "Wise Eating & Fitness Planner";
"Promo.WiseEating.description" = "Wise Eating er din AI-drevne coach til smartere ernæring og træning. Den kombinerer moderne ernæringsvidenskab med praktiske værktøjer til at hjælpe dig med at planlægge måltider, designe træning, styre dit spisekammer og forstå, hvordan mad og bevægelse påvirker din krop.";
"Promo.StoreFront.name" = "StoreFront Studio";
"Promo.StoreFront.description" = "StoreFront Studio er et avanceret 3D-designmiljø til iOS- og macOS-udviklere. Det kombinerer præcis RealityKit-gengivelse med en effektiv editor til formateret tekst, så du kan omdanne rå skærmbilleder til professionelle materialer til App Store.";
"Promo.ReelStudio.name" = "ReelStudio";
"Promo.ReelStudio.description" = "ReelStudio er skærmoptagelsesstudiet af skabergrad for iOS og macOS. Optag din skærm og dit kamera på samme tid, styr mikrofon + systemlyd, og eksporter rene MP4'er til tutorials, gennemgange og produktdemoer. På iOS kan du endda afspille en video inde i appen og optage den sammen med dit kamera til reaktionsstil og præsentationsstyret indhold.";
"Promo.MarketBrief.name" = "MarketBrief AI";
"Promo.MarketBrief.description" = "MarketBrief AI hjælper dig med at forstå markedsbevægelser med analyse på enheden og en arbejdsgang med flere agenter, der er udviklet til at adskille signal fra støj. Følg prisdata i realtid, undersøg sandsynligheder for markedsregimer, og brug overskuelige dashboards og diagrammer som støtte for dine beslutninger. Privatliv først: Dine konfigurationer bliver på enheden.";

